# Model IDs
ORCHESTRATOR_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
TEACHER_MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# Generation settings
MAX_NEW_TOKENS=1024
TEMPERATURE=0.0

# device_map is passed directly to the transformers pipeline.
# "auto"  — uses GPU if available, falls back to CPU
# "cpu"   — force CPU
DEVICE_MAP=auto

# CLI and demo defaults
DEFAULT_QUESTION_COUNT=5
