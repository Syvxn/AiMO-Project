; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AiMO_game_proto"
run/main_scene="uid://bqdkxfg4o3384"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/show_image=false
config/icon="uid://bng85tuelwpxo"

[autoload]

NetworkHandler="*uid://clyvgvpwu0knk"
SignalBus="*uid://tspfsguyxkbx"

[display]

window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://autoloads/": "yellow",
"res://exports/": "red",
"res://items/": "purple",
"res://npcs/": "purple",
"res://player/": "purple",
"res://rooms/": "purple",
"res://textures/": "blue",
"res://textures/sprite_frames/": "blue",
"res://textures/spritesheets/": "blue",
"res://textures/static_textures/": "blue",
"res://textures/tilesets/": "blue",
"res://textures/tilesheets/": "blue",
"res://ui/": "green"
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
