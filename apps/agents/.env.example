# Copy this file to .env and adjust values as needed.
# Never commit your real .env — it is gitignored.
# For team workflows, keep shared defaults in .env and put machine-specific
# overrides (GPU/CPU, model size) in .env.local.

# ── Models ────────────────────────────────────────────────────────────────────
# Any HuggingFace text-generation model ID works here.
# Smaller models (1.5B) load faster; larger models (7B+) produce better quizzes.
TEACHER_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
ORCHESTRATOR_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# Sentence-Transformers model used to embed RAG chunks.
RAG_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# ── Generation ────────────────────────────────────────────────────────────────
MAX_NEW_TOKENS=1024
# Set TEMPERATURE=0.0 for fully deterministic output.
TEMPERATURE=0.2
# "auto" uses GPU if available and falls back to CPU; "cpu" forces CPU.
DEVICE_MAP=auto

# ── Quiz defaults ─────────────────────────────────────────────────────────────
DEFAULT_QUESTION_COUNT=5

# ── RAG ───────────────────────────────────────────────────────────────────────
# Path to the directory containing .txt study-material files (relative to project root).
MATERIAL_DIR=data/materials/chapters
RAG_CHUNK_SIZE=200
RAG_CHUNK_OVERLAP=40
RAG_TOP_K=5
# Minimum cosine-similarity score for a chunk to be included in the context.
RAG_SCORE_THRESHOLD=0.30
