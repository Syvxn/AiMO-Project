# Optional. Every setting below already has this value as its default, so you only need
# a .env file (or a gitignored .env.local for machine-specific values) to change one.

# One chat model writes the quizzes and talks as the NPCs; equal IDs share one copy in memory.
TEACHER_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
ORCHESTRATOR_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
TEACHER_QUANTIZATION=none

# "auto" uses the GPU when CUDA is available and the CPU otherwise; "cpu" forces the CPU.
DEVICE_MAP=auto

# 0 gives deterministic output; higher values give more varied questions.
TEMPERATURE=0.2

DEFAULT_QUESTION_COUNT=5
