[sub_resource type="GDScript" id="GDScript_3eadt"]
script/source = "extends Camera2D

var view := \"normal\"

@export var zoom_min := 1
@export var zoom_max := 5.0

func enable_if_authority():
	if (is_multiplayer_authority() or get_parent().debug):
		enabled = true


func zoom_in():
	zoom.x = clamp(zoom.x+1.0, zoom_min, zoom_max)
	zoom.y = clamp(zoom.y+1.0, zoom_min, zoom_max)

func zoom_out():
	zoom.x = clamp(zoom.x-1.0, zoom_min, zoom_max)
	zoom.y = clamp(zoom.y-1.0, zoom_min, zoom_max)


func toggle_view():
	if view == \"normal\":
		view = \"customize\"
		offset.x = 60
		zoom = Vector2(5.0, 5.0)
	else:
		view = \"normal\"
		offset = Vector2.ZERO
		zoom = Vector2(2.0, 2.0)
"

