[sub_resource type="GDScript" id="GDScript_x0jl3"]
script/source = "extends MultiplayerSynchronizer

# the resulting direction is replicated accross all peers
var walk_direction := Vector2.ZERO
var auto_move := false
var auto_move_target : Vector2

func _physics_process(_delta: float) -> void:
	# inputs are only processed for the client's player instance
	if not (is_multiplayer_authority() or get_parent().debug):
		return
	if not get_parent().controllable:
		return
	
	if Input.is_action_just_pressed(\"move_to\"):
		#this sucks, but is also way more direct than trying to signal
		auto_move_target = get_parent().get_node(\"Camera2D\").get_global_mouse_position()
		auto_move = true
	walk_direction = Input.get_vector(\"move_left\", \"move_right\", \"move_up\", \"move_down\")
	if walk_direction:
		auto_move = false
	if Input.is_action_just_pressed(\"interact\"):
		var areas = get_parent().get_node(\"InteractionArea\").get_overlapping_areas()
		for area in areas:
			if area.is_in_group(\"npcs\") and \"interact\" in area:
				area.interact()
	if Input.is_action_just_pressed(\"inventory\"):
		#get_parent().get_node(\"CharacterSprites\").randomize_colors()
		get_parent().toggle_customize_menu()
	if Input.is_action_just_pressed(\"oops\"):
		SignalBus.oops_pressed.emit()
	if Input.is_action_pressed(\"shift\"):
		if Input.is_action_just_pressed(\"scroll_up\"):
			get_parent().get_node(\"Camera2D\").zoom_in()
		if Input.is_action_just_pressed(\"scroll_down\"):
			get_parent().get_node(\"Camera2D\").zoom_out()
	
"

