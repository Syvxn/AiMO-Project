[sub_resource type="GDScript" id="GDScript_gtmdk"]
script/source = "extends CanvasLayer


@onready var tunnel_escape = preload(\"res://misc/3d_test/tunnel_escape.tscn\")


func launch_arcade_game():
	SignalBus.arcade_game_launched.emit()
	%ArcadeViewport.add_child(tunnel_escape.instantiate())
	show()


func close_menu():
	hide()
	for child in %ArcadeViewport.get_children():
		child.queue_free()
	SignalBus.arcade_game_closed.emit()
"

